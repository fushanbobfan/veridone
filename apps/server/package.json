{
  "name": "@veridone/server",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "veridone": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.0.11",
    "@veridone/adapters": "workspace:*",
    "@veridone/core": "workspace:*",
    "better-sqlite3": "13.0.1",
    "hono": "4.13.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13"
  }
}
