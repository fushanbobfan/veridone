{
  "name": "@veridone/server",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "veridone": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup --config tsup.config.ts && tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@veridone/adapters": "workspace:*",
    "@veridone/core": "workspace:*",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  }
}
