{
  "name": "veridone-workspace",
  "version": "1.2.0",
  "private": true,
  "description": "Local-first acceptance desk for AI-assisted software work",
  "license": "MIT",
  "repository": "github:fushanbobfan/veridone",
  "homepage": "https://fushanbobfan.github.io/veridone/",
  "bugs": "https://github.com/fushanbobfan/veridone/issues",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @veridone/server dev\" \"pnpm --filter @veridone/web dev\"",
    "start": "concurrently -n server,web -c blue,green \"pnpm --filter @veridone/server start\" \"pnpm --filter @veridone/web preview\"",
    "build": "pnpm -r build",
    "smoke:built": "node scripts/smoke-built.mjs",
    "walk:first-workspace": "node scripts/walks/walk-first-workspace.mjs",
    "walk:upgrade": "node scripts/walks/walk-upgrade.mjs",
    "walk:dead-ends": "node scripts/walks/walk-dead-ends.mjs",
    "walk:removal": "node scripts/walks/walk-removal.mjs",
    "walk:release": "node scripts/walks/release-all.mjs",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "oxlint --deny-warnings apps packages",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium-local --project=chromium-verdicts --project=chromium-removal --project=chromium-demo --project=mobile-chromium --project=chromium-built --project=chromium-pages",
    "verify:packet": "tsx apps/server/src/verify-packet.ts",
    "verify:published-evidence": "tsx apps/server/src/verify-evidence-directory.ts docs/evidence/dogfood",
    "licenses:check": "node scripts/check-licenses.mjs",
    "secrets:check": "node scripts/secret-scan.mjs",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm verify:published-evidence && pnpm build && pnpm smoke:built && pnpm audit --audit-level low && pnpm licenses:check && pnpm secrets:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "concurrently": "10.0.7",
    "oxlint": "1.92.0",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
