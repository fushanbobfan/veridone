{
  "name": "veridone-workspace",
  "version": "1.0.1",
  "private": true,
  "description": "Local-first acceptance desk for AI-assisted software work",
  "license": "MIT",
  "repository": "github:fushanbobfan/veridone",
  "homepage": "https://fushanbobfan.github.io/veridone/",
  "bugs": "https://github.com/fushanbobfan/veridone/issues",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @veridone/server dev\" \"pnpm --filter @veridone/web dev\"",
    "start": "concurrently -n server,web -c blue,green \"pnpm --filter @veridone/server start\" \"pnpm --filter @veridone/web preview\"",
    "build": "pnpm -r build",
    "smoke:built": "node scripts/smoke-built.mjs",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "oxlint --deny-warnings apps packages",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium-local --project=chromium-demo --project=mobile-chromium",
    "verify:packet": "tsx apps/server/src/verify-packet.ts",
    "licenses:check": "node scripts/check-licenses.mjs",
    "secrets:check": "node scripts/secret-scan.mjs",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:built && pnpm audit --audit-level low && pnpm licenses:check && pnpm secrets:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "concurrently": "10.0.3",
    "oxlint": "1.75.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
